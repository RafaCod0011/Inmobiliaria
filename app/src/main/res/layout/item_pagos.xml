<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Código de pago -->
        <TextView
            android:id="@+id/tvLabelCodigoPago"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Código de pago:"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvCodigoPago"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="14sp"
            app:layout_constraintBaseline_toBaselineOf="@id/tvLabelCodigoPago"
            app:layout_constraintStart_toEndOf="@id/tvLabelCodigoPago"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Fecha de pago -->
        <TextView
            android:id="@+id/tvLabelFechaPago"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Fecha de pago:"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tvLabelCodigoPago"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvFechaPago"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="12dp"
            android:textSize="14sp"
            app:layout_constraintBaseline_toBaselineOf="@id/tvLabelFechaPago"
            app:layout_constraintStart_toEndOf="@id/tvLabelFechaPago"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Monto -->
        <TextView
            android:id="@+id/tvLabelMonto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Monto:"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tvLabelFechaPago"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvMonto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="12dp"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBaseline_toBaselineOf="@id/tvLabelMonto"
            app:layout_constraintStart_toEndOf="@id/tvLabelMonto"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Detalle -->
        <TextView
            android:id="@+id/tvLabelDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Detalle:"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tvLabelMonto"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvDetalle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="12dp"
            android:textSize="14sp"
            app:layout_constraintBaseline_toBaselineOf="@id/tvLabelDetalle"
            app:layout_constraintStart_toEndOf="@id/tvLabelDetalle"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Código de contrato -->
        <TextView
            android:id="@+id/tvLabelCodigoContrato"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:text="Código contrato:"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tvLabelDetalle"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvCodigoContrato"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:textSize="14sp"
            app:layout_constraintBaseline_toBaselineOf="@id/tvLabelCodigoContrato"
            app:layout_constraintStart_toEndOf="@id/tvLabelCodigoContrato"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>