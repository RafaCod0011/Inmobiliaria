<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Inmobiliaria" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/green</item>
        <item name="colorPrimaryVariant">@color/green_dark</item>
        <item name="colorOnPrimary">@color/black</item>

        <item name="colorSecondary">@color/accent_warm</item>
        <item name="colorSecondaryVariant">@color/accent_warm_dark</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnBackground">@color/text_dark</item>
        <item name="colorOnSurface">@color/text_dark</item>

        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <style name="Theme.Inmobiliaria.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>